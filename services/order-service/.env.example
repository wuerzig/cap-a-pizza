# ============================================================================
#  OrderService configuration
# ============================================================================
#  Copy this file to `.env` (same folder) before running docker compose:
#      cp .env.example .env
#
#  >>> THIS FILE IS THE MAIN DIAL FOR THE SESSION 1 CAP EXPERIMENT <<<
# ============================================================================

# --- MongoDB connection ------------------------------------------------------
# Note we list ALL THREE replica-set members in the URI. The driver discovers
# the topology and always routes writes to whoever is currently PRIMARY.
MONGO_URI=mongodb://mongo-primary:27017,mongo-sec-1:27017,mongo-sec-2:27017/?replicaSet=rs0
MONGO_DB=pizzeria

# --- WriteConcern  (THE CAP LEVER) ------------------------------------------
# Run the experiment by pausing exactly ONE secondary (e.g. mongo-sec-1).
# The primary keeps its 2/3 majority and stays PRIMARY, so the ONLY thing that
# changes between the two settings is how many acknowledgments a write waits for:
#
#   1  -> wait for the primary only. The paused node is irrelevant, so orders
#         are accepted and reported as fully replicated (✓ on the dashboard).
#   3  -> wait for ALL THREE nodes. The paused node can never acknowledge, so
#         the write concern times out. The order is STILL accepted and baked
#         (the data is committed on the primary) -- but it is flagged as NOT
#         REPLICATED (✗ w=3) on the dashboard. That flag is the whole point:
#         it makes the consistency/availability trade-off concrete. You stayed
#         available, but you did NOT get the durability you asked for.
#
# IMPORTANT: do NOT pause two secondaries for this. With only one of three
# nodes left, MongoDB forces the isolated primary to step down and ALL writes
# fail with 503 regardless of this setting -- that separately demonstrates that
# MongoDB is fundamentally CP.
MONGO_WRITE_CONCERN=1

# --- Downstream services (synchronous calls -- removed in Lab 2) ------------
KITCHEN_URL=http://kitchen-service:8001
PAYMENT_URL=http://payment-service:8002
